# Environment Variables Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=platform_secure_pass
POSTGRES_DB=featurehub_dataguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://platform_admin:platform_secure_pass@localhost:5432/featurehub_dataguard

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# FeatureHub Service Configuration
FEATUREHUB_API_HOST=0.0.0.0
FEATUREHUB_API_PORT=8000
FEATUREHUB_DB_URL=postgresql://platform_admin:platform_secure_pass@postgres:5432/featurehub_dataguard
OFFLINE_STORE_PATH=/tmp/featurehub/offline_store

# DataGuard Service Configuration
DATAGUARD_API_HOST=0.0.0.0
DATAGUARD_API_PORT=8001
DATAGUARD_DB_URL=postgresql://platform_admin:platform_secure_pass@postgres:5432/featurehub_dataguard
CONTRACTS_DIR=dataguard/contracts

# Streamlit Configuration
FEATUREHUB_DASHBOARD_PORT=8501
DATAGUARD_DASHBOARD_PORT=8502

# Airflow Configuration
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_DB_URL=postgresql://platform_admin:platform_secure_pass@postgres:5432/featurehub_dataguard
AIRFLOW__CORE__LOAD_EXAMPLES=False
