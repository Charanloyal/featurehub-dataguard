# ==============================================================================
# FEATUREHUB + DATAGUARD CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and customize for your environment.
# Never commit credentials, tokens, or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORM MODE & ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: "LOCAL_FULL" (Docker: Postgres, Redis, Airflow) or "PUBLIC_DEMO" (Lightweight public gateway)
PLATFORM_MODE=PUBLIC_DEMO
ENVIRONMENT=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. PUBLIC DEMO & GATEWAY SETTINGS (PUBLIC_*)
# ------------------------------------------------------------------------------
# Public API gateway port and bind address
PUBLIC_API_HOST=0.0.0.0
PUBLIC_API_PORT=8000
PUBLIC_API_URL=http://localhost:8000

# Public Unified Dashboard port
PUBLIC_DASHBOARD_HOST=0.0.0.0
PUBLIC_DASHBOARD_PORT=8505
PUBLIC_DASHBOARD_URL=http://localhost:8505

# CORS Allowed Origins (Comma-separated)
PUBLIC_CORS_ORIGINS=http://localhost:8505,https://*.lhr.life,https://*.ngrok-free.app

# Public Rate Limits & Timeouts
PUBLIC_REQUEST_TIMEOUT_SECONDS=10.0
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# 3. LOCAL FULL PLATFORM SETTINGS (LOCAL_*)
# ------------------------------------------------------------------------------
# PostgreSQL 16 (Contract Registry, Incident Store, Pipeline Run Logs)
LOCAL_POSTGRES_HOST=localhost
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DB=featurehub_dataguard
LOCAL_POSTGRES_USER=platform_admin
LOCAL_POSTGRES_PASSWORD=your_secure_password_here
LOCAL_DATABASE_URL=postgresql://${LOCAL_POSTGRES_USER}:${LOCAL_POSTGRES_PASSWORD}@${LOCAL_POSTGRES_HOST}:${LOCAL_POSTGRES_PORT}/${LOCAL_POSTGRES_DB}

# Redis 7.2 (Online Feature Store & Fast Entity Lookups)
LOCAL_REDIS_HOST=localhost
LOCAL_REDIS_PORT=6379
LOCAL_REDIS_PASSWORD=

# FeatureHub Microservices
LOCAL_FEATUREHUB_HOST=127.0.0.1
LOCAL_FEATUREHUB_PORT=8010
LOCAL_FEATUREHUB_API_URL=http://127.0.0.1:8010

# DataGuard Microservices
LOCAL_DATAGUARD_HOST=127.0.0.1
LOCAL_DATAGUARD_PORT=8001
LOCAL_DATAGUARD_API_URL=http://127.0.0.1:8001

# Airflow 2.9 Orchestration (Scheduler & Webserver)
LOCAL_AIRFLOW_HOST=localhost
LOCAL_AIRFLOW_PORT=8080
LOCAL_AIRFLOW_URL=http://localhost:8080
LOCAL_AIRFLOW_USER=airflow
LOCAL_AIRFLOW_PASSWORD=your_airflow_password_here
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Observability (Prometheus & OpenLineage)
LOCAL_PROMETHEUS_PORT=9090
LOCAL_PROMETHEUS_URL=http://localhost:9090
LOCAL_OPENLINEAGE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. PATHS & STORAGE
# ------------------------------------------------------------------------------
OFFLINE_STORE_PATH=./data/offline_store
CONTRACTS_DIR=./dataguard/contracts
DATA_DIR=./data
BENCHMARKS_DIR=./featurehub/benchmarks
